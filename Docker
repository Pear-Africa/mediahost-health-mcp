# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY MediahostHealthMCP.csproj .
RUN dotnet restore
COPY . .
RUN dotnet publish -c Release -o /app --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .

# queries.yaml is mounted at runtime — see SETUP.md
EXPOSE 8000
ENTRYPOINT ["dotnet", "MediahostHealthMCP.dll"]
